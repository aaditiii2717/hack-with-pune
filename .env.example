# Copy this file to .env and add your own secret key locally.
# Use exactly one AI provider key. Never commit .env or share its contents.
GROQ_API_KEY=
# Alternative to Groq: OPENAI_API_KEY=

# Optional: provider-compatible endpoint/model overrides.
# Leave these unset to use the defaults for the selected provider.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-20b

# Local judging demo switch. run.bat currently enables this for synthetic demo data.
KC_DEMO_MODE=1

# Set to 1 when the app is served over HTTPS; keep 0 for local HTTP.
COOKIE_SECURE=0

# Supabase/Postgres connection string. Leave blank for local SQLite development.
DATABASE_URL=
